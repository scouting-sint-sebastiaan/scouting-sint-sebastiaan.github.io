---
import Base from '../layouts/Base.astro';
import AgendaLijst from '../components/AgendaLijst.astro';
import { activiteiten } from '../lib/agenda';

const lijst = await activiteiten();
---

<Base title="Agenda">
  <div class="wrap">
    <div class="pagina">
      <h1>Agenda</h1>
      <AgendaLijst lijst={lijst} ics="/agenda.ics" />
    </div>
  </div>
</Base>
