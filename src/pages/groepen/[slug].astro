---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AgendaLijst from '../../components/AgendaLijst.astro';
import { activiteiten } from '../../lib/agenda';

export async function getStaticPaths() {
  const speltakken = await getCollection('speltakken');
  return speltakken.map((s) => ({ params: { slug: s.id }, props: { speltak: s } }));
}

const { speltak } = Astro.props;
const { Content } = await render(speltak);
const d = speltak.data;
const agenda = await activiteiten(speltak.id);
---

<Base title={d.title} kruimels={[{ naam: 'Onze groepen', href: '/groepen/' }, { naam: d.title }]}>
  <div class="wrap">
    <article class="pagina speltak" data-speltak={speltak.id}>
      <h1>{d.title}</h1>
      {d.image && <img src={d.image} alt="" />}
      <dl class="feiten">
        <dt>Leeftijd</dt><dd>{d.leeftijd}</dd>
        {d.draaitijd && <><dt>Wanneer</dt><dd>{d.draaitijd}</dd></>}
        {d.staf && <><dt>Leiding</dt><dd>{d.staf}</dd></>}
        {d.email && <><dt>E-mail</dt><dd><a href={`mailto:${d.email}`}>{d.email}</a></dd></>}
      </dl>
      <div class="inhoud"><Content /></div>

      <h2>Komende activiteiten</h2>
      <AgendaLijst lijst={agenda} ics={`/groepen/${speltak.id}.ics`} leeg={`Er staan nog geen activiteiten voor de ${d.title.toLowerCase()} gepland.`} />
    </article>
  </div>
</Base>
