---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const speltakken = (await getCollection('speltakken')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Onze groepen">
  <div class="wrap">
    <div class="pagina breed">
      <h1>Onze groepen</h1>
      <p>Scouting is er voor alle leeftijden. Op zaterdag staat de deur voor iedereen open, kom gerust eens kijken.</p>
      <ul class="nieuws speltakken">
        {speltakken.map((s) => (
          <li data-speltak={s.id}>
            <a href={`/groepen/${s.id}/`}>
              <div class="titel"><h3>{s.data.title}</h3></div>
              <p class="tekst">{s.data.leeftijd}{s.data.draaitijd && <><br />{s.data.draaitijd}</>}</p>
              <span class="lees-meer">Lees meer</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>
