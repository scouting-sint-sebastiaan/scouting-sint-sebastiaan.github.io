---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NieuwsKaart from '../../components/NieuwsKaart.astro';

const nieuws = (await getCollection('nieuws')).sort((a, b) => +b.data.date - +a.data.date);
---

<Base title="Nieuws">
  <div class="wrap">
    <div class="pagina breed">
      <h1>Nieuws</h1>
      {nieuws.length === 0 && <p class="meta">Er is nog geen nieuws.</p>}
      <ul class="nieuws">
        {nieuws.map((n) => <NieuwsKaart bericht={n} />)}
      </ul>
    </div>
  </div>
</Base>
