---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/300-italic.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/roboto-slab/700.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import Icoon from '../components/Icoon.astro';

interface Kruimel {
  naam: string;
  href?: string;
}
interface Props {
  title?: string;
  description?: string;
  kruimels?: Kruimel[];
}
const { title, description } = Astro.props;
const fullTitle = title ? `${title} | ${site.naam}` : site.naam;
const kruimels = Astro.props.kruimels ?? (title ? [{ naam: title }] : []);

const speltakken = (await getCollection('speltakken')).sort((a, b) => a.data.order - b.data.order);
const paginas = [...(await getCollection('paginas')), ...(await getCollection('speciaal'))].sort(
  (a, b) => a.data.order - b.data.order,
);
const menu = (m: string) => paginas.filter((p) => p.data.menu === m);

const pad = Astro.url.pathname;
const actief = (href: string) => (href === '/' ? pad === '/' : pad.startsWith(href));
const inMenu = (m: string) => menu(m).some((p) => pad === `/${p.id}/`);
const huidig = (aan: boolean) => (aan ? 'huidig' : undefined);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {import.meta.env.PUBLIC_NOINDEX && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/uploads/logo-basje.png" />
    <link rel="preload" href="/tc4/UrbanJungle.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header id="kop">
      <a class="logo" href="/" aria-label={`${site.naam}, naar de homepagina`}>
        <img src="/uploads/logo-scouting-nederland.png" alt="" width="58" height="60" />
        <span>St.<br />Sebastiaan<br /><small>Strijp</small></span>
      </a>
      <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Menu openen" />
      <label for="menu-toggle" class="menu-knop" title="Menu"><Icoon naam="bars" /></label>
      <nav class="menu" aria-label="Hoofdmenu">
        <ul>
          <li class={huidig(actief('/'))}><a href="/">Home</a></li>
          <li class:list={['sub', huidig(actief('/groepen/'))]}>
            <a href="/groepen/">Onze groepen</a>
            <ul>
              {speltakken.map((s) => <li><a href={`/groepen/${s.id}/`}>{s.data.title}</a></li>)}
            </ul>
          </li>
          <li class:list={['sub', huidig(inMenu('ontdek'))]}>
            <a href={`/${menu('ontdek')[0]?.id}/`}>Ontdek scouting</a>
            <ul>
              {menu('ontdek').map((p) => <li><a href={`/${p.id}/`}>{p.data.title}</a></li>)}
            </ul>
          </li>
          <li class:list={['sub', huidig(inMenu('lid-worden'))]}>
            <a href={`/${menu('lid-worden')[0]?.id}/`}>Lid worden</a>
            <ul>
              {menu('lid-worden').map((p) => <li><a href={`/${p.id}/`}>{p.data.title}</a></li>)}
            </ul>
          </li>
          <li class={huidig(actief('/nieuws/'))}><a href="/nieuws/">Nieuws</a></li>
          <li class={huidig(actief('/agenda/'))}><a href="/agenda/">Agenda</a></li>
          <li class={huidig(actief('/contact/'))}><a href="/contact/">Contact</a></li>
          <li class="extra"><a href={`mailto:${site.email}`} title="Mail ons"><Icoon naam="envelope" /></a></li>
          <li class="extra"><a href={site.facebook} rel="noopener" title="Facebook"><Icoon naam="facebook" /></a></li>
          <li class="extra"><a href={site.instagram} rel="noopener" title="Instagram"><Icoon naam="instagram" /></a></li>
        </ul>
      </nav>
    </header>

    <main class:list={{ 'zonder-banner': pad !== '/' }}>
      {kruimels.length > 0 && (
        <nav class="wrap kruimels" aria-label="Kruimelpad">
          <a href="/">Home</a>
          {kruimels.map((k) => (
            <>
              {' » '}
              {k.href ? <a href={k.href}>{k.naam}</a> : <span>{k.naam}</span>}
            </>
          ))}
        </nav>
      )}
      <slot />
    </main>

    <footer id="voet">
      <div class="wrap voet-in">
        <div>
          <h2>Vind ons op</h2>
          <p class="social">
            <a href={site.facebook} rel="noopener" title="Facebook"><Icoon naam="facebook" /></a>
            <a href={site.instagram} rel="noopener" title="Instagram"><Icoon naam="instagram" /></a>
            <a href={`mailto:${site.email}`} title="Mail ons"><Icoon naam="envelope" /></a>
          </p>
        </div>
        <ul>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/agenda/">Agenda</a></li>
          <li><a href={`/${menu('lid-worden')[0]?.id}/`}>Lid worden</a></li>
          <li><a href="https://www.scouting.nl" rel="noopener">Scouting Nederland</a></li>
        </ul>
        <p class="adres">
          {site.naam}<br />
          {site.adres}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
      <p class="wrap copyright">Dit is de officiële website van {site.naam}.</p>
    </footer>
  </body>
</html>
