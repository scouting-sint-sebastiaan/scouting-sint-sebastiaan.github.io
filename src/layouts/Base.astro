---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/300-italic.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/roboto-slab/700.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import algemeen from '../data/algemeen.json';
import geavanceerd from 'virtual:geavanceerd';
import melding from '../data/melding.json';
import Icoon from '../components/Icoon.astro';

interface Kruimel {
  naam: string;
  href?: string;
}
interface Props {
  title?: string;
  description?: string;
  kruimels?: Kruimel[];
  zoekbaar?: boolean;
}
const { title, description, zoekbaar = true } = Astro.props;
const fullTitle = title ? `${title} | ${site.naam}` : site.naam;
const kruimels = Astro.props.kruimels ?? (title ? [{ naam: title }] : []);

const speltakken = (await getCollection('speltakken')).sort((a, b) => a.data.order - b.data.order);
const paginas = [...(await getCollection('paginas')), ...(await getCollection('speciaal'))].sort(
  (a, b) => a.data.order - b.data.order,
);
const menu = (m: string) => paginas.filter((p) => p.data.menu === m);

const pad = Astro.url.pathname;
const actief = (href: string) => (href === '/' ? pad === '/' : pad.startsWith(href));
const inMenu = (m: string) => menu(m).some((p) => pad === `/${p.id}/`);
const huidig = (aan: boolean) => (aan ? 'huidig' : undefined);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/uploads/logo-basje.png" />
    <link rel="preload" href="/tc4/UrbanJungle.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header id="kop">
      <a class="logo" href="/" aria-label={`${site.naam}, naar de homepagina`}>
        <img src="/uploads/logo-scouting-nederland.png" alt="" width="58" height="60" />
        <span>St.<br />Sebastiaan<br /><small>Strijp</small></span>
      </a>
      <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Menu openen" />
      <label for="menu-toggle" class="menu-knop" title="Menu"><Icoon naam="bars" /></label>
      <nav class="menu" aria-label="Hoofdmenu">
        <ul>
          <li class={huidig(actief('/'))}><a href="/">Home</a></li>
          <li class:list={['sub', huidig(actief('/groepen/'))]}>
            <a href="/groepen/">Onze groepen</a>
            <ul>
              {speltakken.map((s) => <li><a href={`/groepen/${s.id}/`}>{s.data.title}</a></li>)}
            </ul>
          </li>
          <li class:list={['sub', huidig(inMenu('ontdek'))]}>
            <a href={`/${menu('ontdek')[0]?.id}/`}>Ontdek scouting</a>
            <ul>
              {menu('ontdek').map((p) => <li><a href={`/${p.id}/`}>{p.data.title}</a></li>)}
            </ul>
          </li>
          <li class:list={['sub', huidig(inMenu('lid-worden'))]}>
            <a href={`/${menu('lid-worden')[0]?.id}/`}>Lid worden</a>
            <ul>
              {menu('lid-worden').map((p) => <li><a href={`/${p.id}/`}>{p.data.title}</a></li>)}
            </ul>
          </li>
          <li class={huidig(actief('/nieuws/'))}><a href="/nieuws/">Nieuws</a></li>
          <li class={huidig(actief('/agenda/'))}><a href="/agenda/">Agenda</a></li>
          <li class={huidig(actief('/contact/'))}><a href="/contact/">Contact</a></li>
          <li class="extra"><a href={`mailto:${algemeen.email}`} title="Mail ons"><Icoon naam="envelope" /></a></li>
          {algemeen.facebook && <li class="extra"><a href={algemeen.facebook} title="Facebook"><Icoon naam="facebook" /></a></li>}
          {algemeen.instagram && <li class="extra"><a href={algemeen.instagram} title="Instagram"><Icoon naam="instagram" /></a></li>}
          <li class="extra"><a href="/zoeken/" title="Zoeken"><Icoon naam="zoeken" /></a></li>
        </ul>
      </nav>
    </header>

    <main class:list={{ 'zonder-banner': pad !== '/' }} data-pagefind-body={zoekbaar ? '' : undefined}>
      {melding.aan && melding.tekst && (
        <div class="melding-balk" data-pagefind-ignore data-tot={melding.tot || undefined} role="status">
          <div class="wrap">
            <strong>Let op:</strong> {melding.tekst}
            {melding.link && <> <a href={melding.link}>Meer informatie</a></>}
          </div>
        </div>
      )}
      {kruimels.length > 0 && (
        <nav class="wrap kruimels" data-pagefind-ignore aria-label="Kruimelpad">
          <a href="/">Home</a>
          {kruimels.map((k) => (
            <>
              {' » '}
              {k.href ? <a href={k.href}>{k.naam}</a> : <span>{k.naam}</span>}
            </>
          ))}
        </nav>
      )}
      <slot />
    </main>

    <footer id="voet">
      {geavanceerd.footer.trim() ? <Fragment set:html={geavanceerd.footer} /> : (
        <>
      <div class="wrap voet-in">
        <div>
          <h2>Vind ons op</h2>
          <p class="social">
            {algemeen.facebook && <a href={algemeen.facebook} title="Facebook"><Icoon naam="facebook" /></a>}
            {algemeen.instagram && <a href={algemeen.instagram} title="Instagram"><Icoon naam="instagram" /></a>}
            <a href={`mailto:${algemeen.email}`} title="Mail ons"><Icoon naam="envelope" /></a>
          </p>
        </div>
        <ul>
          {algemeen.voetLinks.map((l) => <li><a href={l.link}>{l.tekst}</a></li>)}
        </ul>
        <p class="adres">
          {site.naam}<br />
          {algemeen.adres}<br />
          <a href={`mailto:${algemeen.email}`}>{algemeen.email}</a>
        </p>
      </div>
      <p class="wrap copyright">Dit is de officiële website van {site.naam}.</p>
        </>
      )}
    </footer>
    <script is:inline>
      (() => {
        const balk = document.querySelector('.melding-balk[data-tot]');
        const vandaag = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Amsterdam' });
        if (balk && balk.dataset.tot < vandaag) balk.remove();
      })();
    </script>
  </body>
</html>
